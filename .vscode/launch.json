    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pulse",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/pulse/main.go",
            "args": [
                "audio",
                "1.m4a"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "name": "Pulse API",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/pulse-api/main.go",
            "args": [],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "name": "Agent",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/agent/main.go",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
        }
    ]
}
